{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "国际影片征集审定领域资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "record_types",
    "workflow_states",
    "facts",
    "policies",
    "sample"
  ],
  "properties": {
    "domain": {
      "const": "film-submission-review"
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "record_types": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "workflow_states": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "append_only_events",
        "dedup",
        "access",
        "recusal",
        "isolation",
        "traceability"
      ],
      "properties": {
        "append_only_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dedup": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "type": "string",
          "minLength": 1
        },
        "recusal": {
          "type": "string",
          "minLength": 1
        },
        "isolation": {
          "type": "string",
          "minLength": 1
        },
        "traceability": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "film",
        "countries",
        "runtime_minutes",
        "subtitle_languages",
        "submission",
        "rights",
        "media_versions",
        "technical_spec",
        "screening_authorization",
        "reviewable_files",
        "missing_items",
        "recusals",
        "scores",
        "append_records",
        "decision"
      ],
      "properties": {
        "film": {
          "type": "string",
          "minLength": 1
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "runtime_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "subtitle_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submission": {
          "type": "object",
          "required": [
            "id",
            "section",
            "state",
            "premiere_status",
            "declarations"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "minLength": 1
            },
            "premiere_status": {
              "type": "string",
              "minLength": 1
            },
            "declarations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "rights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "holder"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "holder": {
                "type": "string",
                "minLength": 1
              },
              "share": {
                "type": "string"
              }
            }
          }
        },
        "media_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "file_digest",
              "upload_seq",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              },
              "file_digest": {
                "type": "string",
                "pattern": "^sha256:"
              },
              "upload_seq": {
                "type": "integer",
                "minimum": 1
              },
              "submitted_by": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "subtitle_languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "technical_spec": {
          "type": "object",
          "minProperties": 1
        },
        "screening_authorization": {
          "type": "object",
          "required": [
            "id",
            "granted",
            "media"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string"
            },
            "granted": {
              "type": "boolean"
            },
            "media": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "reviewable_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recusals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "judge",
              "reason",
              "declared_at",
              "effective_before_assignment"
            ],
            "properties": {
              "judge": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "declared_at": {
                "type": "string",
                "minLength": 1
              },
              "effective_before_assignment": {
                "const": true
              }
            }
          }
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "judge",
              "value",
              "independent"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "judge": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "independent": {
                "const": true
              }
            }
          }
        },
        "append_records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "seq",
              "type",
              "at"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string"
              },
              "score_id": {
                "type": "string"
              },
              "from": {},
              "to": {}
            }
          }
        },
        "decision": {
          "type": "object",
          "required": [
            "id",
            "result",
            "regulation",
            "valid_media",
            "score_ids",
            "review_process"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "minLength": 1
            },
            "regulation": {
              "type": "string",
              "minLength": 1
            },
            "valid_media": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "score_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "review_process": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "isolated_until": {
              "type": "string"
            },
            "notification_id": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
